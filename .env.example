# Local PostgreSQL development defaults. Copy to .env.local; never commit real credentials.
# For an approved Supabase environment, replace only DATABASE_URL with its server-side SSL connection string.
# Keep DATABASE_POOL_MAX=1 for Vercel serverless traffic unless approved capacity planning says otherwise.
DATABASE_URL=postgresql://fpl_intelligence:local_development_only@127.0.0.1:5432/fpl_intelligence
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
FPL_POSTGRES_PORT=5432
