{
  "name": "@fpl-intelligence/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config=vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fpl-intelligence/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  }
}
